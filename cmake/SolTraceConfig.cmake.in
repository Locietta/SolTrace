@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# nlohmann_json and glm are transitive dependencies of simdata.
# Their headers are installed alongside SolTrace; these calls make
# the CMake targets available for consumers who reference them directly.
find_dependency(nlohmann_json QUIET)
find_dependency(glm QUIET)

include("${CMAKE_CURRENT_LIST_DIR}/SolTraceTargets.cmake")

# If OptiX targets were installed, pull in their required system dependencies
if(TARGET SolTrace::optix_runner)
    find_dependency(CUDAToolkit REQUIRED)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(OptiX REQUIRED)
endif()

check_required_components(SolTrace)
